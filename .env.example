# Edge Vision System - Environment Configuration
# Copy this file to .env in the project root 

# Edge Device Configuration 
# (Used by scripts/start_rpi.sh and infrastructure/edge-device/docker-compose.device.yml)

# Connection to the Central Server's MQTT broker
MQTT_SERVER_URL=tcp://<CENTRAL_SERVER_IP>:1883
MQTT_USERNAME=edge_device
MQTT_PASSWORD=<YOUR_SECURE_MQTT_PASSWORD>

# Device Identification (Unique per Raspberry Pi)
CAMERA_ID=cam-rpi-01

# AI Inference Settings
CONFIDENCE_THR=0.45
CAMERA_FPS=2
COLLECT_INTERVAL=30

# Central Server Configuration
# (Used by infrastructure/central-server/docker-compose.server.yml)

# Edge Device credentials (MUST MATCH the Edge configuration above)
MQTT_USER_EDGE=edge_device
MQTT_PASS_EDGE=<YOUR_SECURE_MQTT_PASSWORD>

# Action Service internal credentials
MQTT_USER_ACTION=action_service
MQTT_PASS_ACTION=<YOUR_SECURE_ACTION_PASSWORD>

# InfluxDB Authentication Token
INFLUX_TOKEN=<YOUR_SECURE_INFLUXDB_TOKEN>

# Grafana Admin Password
GF_SECURITY_ADMIN_PASSWORD=<YOUR_SECURE_GRAFANA_PASSWORD>
