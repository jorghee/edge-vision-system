{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Eventos por Severidad (Últimas 24h)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"ppe_events\")\n  |> filter(fn: (r) => r._field == \"confidence\")\n  |> group(columns: [\"severity\"])\n  |> count()\n  |> yield(name: \"count\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "high" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 2,
      "title": "Total de Alertas",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"ppe_events\" and r.severity != \"none\")\n  |> filter(fn: (r) => r._field == \"confidence\")\n  |> count()\n  |> yield(name: \"total\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Alertas Críticas Hoy",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"ppe_events\" and r.severity == \"critical\")\n  |> filter(fn: (r) => r._field == \"confidence\")\n  |> count()\n  |> yield(name: \"critical\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#F2495C", "mode": "fixed" }
        }
      }
    },
    {
      "id": 4,
      "title": "Confianza Promedio",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"ppe_events\" and r._field == \"confidence\")\n  |> mean()\n  |> yield(name: \"avg\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.7 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Eventos por Dispositivo",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"ppe_events\" and r._field == \"confidence\")\n  |> group(columns: [\"camera_id\"])\n  |> count()\n  |> yield(name: \"by_device\")",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Timeline de Detecciones",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ppe_events\" and r._field == \"confidence\")\n  |> aggregateWindow(every: 5m, fn: count, createEmpty: true)\n  |> yield(name: \"events\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 50 }
        }
      }
    },
    {
      "id": 7,
      "title": "Eventos Recientes (Detalle)",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"ppe_events\")\n  |> filter(fn: (r) => r._field == \"confidence\" or r._field == \"persons_detected\")\n  |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 50)\n  |> yield(name: \"recent\")",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["edge-vision", "ppe", "detection"],
  "templating": {
    "list": [
      {
        "name": "DS_INFLUXDB",
        "type": "datasource",
        "query": "influxdb",
        "current": { "text": "InfluxDB", "value": "InfluxDB" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "PPE Detection - Alertas y Predicciones",
  "uid": "ppe-detection-main"
}
