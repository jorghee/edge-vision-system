{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "CPU (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\" and r._field == \"cpu_percent\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> last()\n  |> yield(name: \"cpu\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Memoria RAM (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\" and r._field == \"memory_percent\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> last()\n  |> yield(name: \"mem\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Temperatura (°C)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\" and r._field == \"temperature_c\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> last()\n  |> yield(name: \"temp\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 20, "max": 90, "unit": "celsius",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Disco (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\" and r._field == \"disk_percent\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> last()\n  |> yield(name: \"disk\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Contenedores Activos",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\" and r._field == \"containers_running\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> last()\n  |> yield(name: \"containers\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Latencia de Inferencia (ms)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\" and r._field == \"inference_latency_ms\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> last()\n  |> yield(name: \"latency\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "CPU / RAM / Temperatura (Histórico)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\")\n  |> filter(fn: (r) => r._field == \"cpu_percent\" or r._field == \"memory_percent\" or r._field == \"temperature_c\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: false)\n  |> yield(name: \"system\")",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Tráfico de Red (TX / RX)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\")\n  |> filter(fn: (r) => r._field == \"net_bytes_tx\" or r._field == \"net_bytes_rx\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> derivative(unit: 1s, nonNegative: true)\n  |> yield(name: \"network\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "id": 9,
      "title": "Frames Procesados (Rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\" and r._field == \"frames_processed\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> derivative(unit: 1m, nonNegative: true)\n  |> yield(name: \"fps\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }
      }
    },
    {
      "id": 10,
      "title": "Errores de Inferencia (Acumulado)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "query": "from(bucket: \"edge-data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_metrics\" and r._field == \"inference_errors\")\n  |> filter(fn: (r) => r.camera_id == \"${camera_id}\")\n  |> yield(name: \"errors\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#F2495C", "mode": "fixed" },
          "custom": { "fillOpacity": 30 }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["edge-vision", "observability", "rpi"],
  "templating": {
    "list": [
      {
        "name": "DS_INFLUXDB",
        "type": "datasource",
        "query": "influxdb",
        "current": { "text": "InfluxDB", "value": "InfluxDB" }
      },
      {
        "name": "camera_id",
        "type": "query",
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"edge-data\", tag: \"camera_id\", predicate: (r) => r._measurement == \"device_metrics\")",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "refresh": 2,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Device Health - Observabilidad RPi",
  "uid": "device-health-main"
}
